{
  "manifest_version": 3,
  "name": "PDF Viewer",
  "version": "0.1.0",
  "description": "Dark-mode PDF viewer with shareable current-page links.",
  "permissions": ["tabs", "webRequest", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "src/assets/luna-mark.png",
    "32": "src/assets/luna-mark.png",
    "48": "src/assets/luna-mark.png",
    "128": "src/assets/luna-mark.png"
  },
  "action": {
    "default_title": "Open in dark PDF viewer",
    "default_icon": "src/assets/luna-mark.png"
  },
  "mime_types_handler": {
    "application/pdf": {
      "handler_url": "src/viewer.html",
      "can_embed": true
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
