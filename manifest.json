{
  "manifest_version": 3,
  "name": "PDF Viewer",
  "version": "0.1.0",
  "description": "Dark-mode PDF viewer with shareable current-page links.",
  "permissions": ["tabs", "webRequest", "clipboardWrite", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.sec.gov/comments/*"],
      "js": ["src/sec-comment.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "src/assets/luna-mark.png",
    "32": "src/assets/luna-mark.png",
    "48": "src/assets/luna-mark.png",
    "128": "src/assets/luna-mark.png"
  },
  "action": {
    "default_title": "Open in dark PDF viewer",
    "default_icon": "src/assets/luna-mark.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
